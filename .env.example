# Local development settings. Set NODE_ENV=production on Render.
NODE_ENV=development
PORT=3000

# Required in production. For Neon, use its TLS URL. Percent-encode special characters.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME

# Required in production. Set privately to a random signing secret of at least 32 bytes.
JWT_SECRET=

# Required in production as an HTTPS origin. Local development can use the web app's loopback URL.
WEB_BASE_URL=http://localhost:3001

# Optional product image uploads. Set the rotated private key privately on the API server.
IMAGEKIT_PRIVATE_KEY=
# Use the delivery endpoint from your ImageKit account dashboard.
IMAGEKIT_URL_ENDPOINT=
# Optional, unused by the server-side upload.
IMAGEKIT_PUBLIC_KEY=

# Optional cashback unlock thresholds. Spend is in hundredths of a new SYP.
CASHBACK_MILESTONE_PURCHASES=5
CASHBACK_MILESTONE_SPEND_SYP=50000

# Local demo seed only. Supply values privately. Opt in to the named development DB per shell.
ALLOW_DEV_DEMO_SEED=
DEMO_SEED_DATABASE_URL=
DEMO_ADMIN_PASSWORD=
DEMO_ACCOUNT_PASSWORD=

# Test database URLs and one-time BOOTSTRAP_ADMIN_* inputs belong in isolated processes.
# See DEPLOYMENT.md and ADMIN_BOOTSTRAP.md.
